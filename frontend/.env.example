# ==============================================================================
# KITS ProjectHub — Frontend Environment Configuration
# ==============================================================================

# VITE_API_URL: Backend API base URL.
# In development, points to the local Express backend on http://localhost:3001/api.
# In production, set this to your deployed backend domain.
VITE_API_URL="http://localhost:3001/api"

# DISABLE_HMR: (Optional) Set to "true" to disable Vite Hot Module Replacement during tests.
# DISABLE_HMR="false"

# Authentication:
# Direct Email & Password authentication handled via backend REST API:
# 1. Registration via POST /api/auth/register (Email, Full Name, Branch, Roll Number, Password)
# 2. Login via POST /api/auth/login
# 3. Secure HttpOnly session cookie ('kits_session') issued and maintained on backend.
# 4. Profile loaded via GET /api/auth/me.

