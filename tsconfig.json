{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./frontend/src/*"]
    }
  },
  "include": [
    "server.ts",
    "backend/src/**/*",
    "frontend/src/**/*",
    "frontend/vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "frontend/dist"
  ]
}
